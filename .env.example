# INSPECT-AI Environment Configuration Example
# Copy this file to .env for local development

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://inspect:inspect@localhost:5432/inspect_ai
# For SQLite local fallback: sqlite:///./inspect_ai.db

# JWT Authentication
JWT_SECRET=inspect-ai-super-secret-key-26095-production-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API Configuration
API_BASE_URL=http://localhost:8000

# External public data
# Keep raw datasets/model artifacts OUTSIDE the repository.
RTIN_EXTERNAL_DATA_DIR=~/rtin-data

# data.gov.in API key and configured resource UUIDs.
# Example: RESOURCE_UUID:UDID district context,RESOURCE_UUID_2:DDAC context
DATAGOV_API_KEY=
DATAGOV_RESOURCES=

# IMD may require public-IP whitelisting for API access.
IMD_API_TOKEN=

ONLINE_DATA_HTTP_TIMEOUT=20
